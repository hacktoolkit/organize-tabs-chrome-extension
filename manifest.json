{
    "manifest_version": 3,
    "name": "Organize Tabs",
    "short_name": "Organize Tabs",
    "version": "1.0.0",
    "description": "Group, sort, deduplicate and tidy your tabs. Understands pull requests, tickets, profiles and documents so duplicates are caught even when the URLs differ.",
    "author": "Hacktoolkit (@hacktoolkit)",
    "minimum_chrome_version": "121",
    "icons": {
        "16": "img/icon16.png",
        "32": "img/icon32.png",
        "48": "img/icon48.png",
        "128": "img/icon128.png"
    },
    "action": {
        "default_icon": {
            "16": "img/icon16.png",
            "32": "img/icon32.png"
        },
        "default_popup": "src/popup.html",
        "default_title": "Organize Tabs"
    },
    "options_ui": {
        "page": "src/options.html",
        "open_in_tab": true
    },
    "background": {
        "service_worker": "src/background.js",
        "type": "module"
    },
    "permissions": [
        "tabs",
        "tabGroups",
        "storage",
        "bookmarks",
        "contextMenus",
        "alarms"
    ],
    "optional_host_permissions": ["https://*/*", "http://*/*"],
    "commands": {
        "_execute_action": {
            "suggested_key": { "default": "Alt+Shift+O" },
            "description": "Open Organize Tabs"
        },
        "dedupe": {
            "suggested_key": { "default": "Alt+Shift+D" },
            "description": "Deduplicate tabs"
        },
        "sortWindow": {
            "suggested_key": { "default": "Alt+Shift+S" },
            "description": "Sort tabs in window"
        },
        "groupByDomain": {
            "suggested_key": { "default": "Alt+Shift+G" },
            "description": "Group tabs by domain"
        },
        "closeScope": { "description": "Close tabs from this domain" },
        "closeBlank": { "description": "Close blank tabs" },
        "closeStale": { "description": "Close stale tabs" },
        "discardStale": { "description": "Free memory (discard stale tabs)" },
        "consolidateAll": { "description": "Consolidate all tabs" },
        "consolidateUnpinned": { "description": "Consolidate unpinned tabs" },
        "parkWindow": { "description": "Park window to bookmarks" },
        "pullMedia": { "description": "Pull meetings and media to a window" },
        "undo": { "description": "Undo last close" }
    }
}
